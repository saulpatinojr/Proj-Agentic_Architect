{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-conductor.dev/schema/contracts.schema.json",
  "title": "Code Conductor Contracts",
  "$defs": {
    "RiskClass": { "type": "string", "enum": ["R0", "R1", "R2", "R3", "R4"] },
    "Stance": { "type": "string", "enum": ["constructive", "critical", "neutral"] },
    "TaskEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "objective", "acceptanceCriteria", "risk", "constraints", "createdAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "repository": { "type": "string" },
        "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
        "risk": { "$ref": "#/$defs/RiskClass" },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "AgentAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "taskId", "agentId", "role", "stance", "provider", "harness", "billingChannel", "authority", "dependsOn"],
      "properties": {
        "id": { "type": "string" }, "taskId": { "type": "string" }, "agentId": { "type": "string" },
        "role": { "type": "string" }, "stance": { "$ref": "#/$defs/Stance" },
        "provider": { "type": "string" }, "harness": { "type": "string" },
        "billingChannel": { "type": "string", "enum": ["subscription", "api", "manual"] },
        "authority": { "type": "array", "items": { "type": "string" } },
        "dependsOn": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "source", "summary"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string", "enum": ["repository", "test", "documentation", "tool", "human", "other"] },
        "source": { "type": "string" }, "summary": { "type": "string" }, "uri": { "type": "string" }, "sha256": { "type": "string" }
      }
    },
    "Finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "severity", "summary", "evidenceIds", "blocking"],
      "properties": {
        "id": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
        "summary": { "type": "string" }, "evidenceIds": { "type": "array", "items": { "type": "string" } }, "blocking": { "type": "boolean" }
      }
    },
    "GateResult": {
      "type": "object", "additionalProperties": false,
      "required": ["gate", "status", "evidenceIds"],
      "properties": {
        "gate": { "type": "string" }, "status": { "type": "string", "enum": ["passed", "failed", "skipped"] },
        "evidenceIds": { "type": "array", "items": { "type": "string" } }, "summary": { "type": "string" }
      }
    },
    "AgentResult": {
      "type": "object", "additionalProperties": false,
      "required": ["taskId", "assignmentId", "agentId", "role", "stance", "provider", "harness", "billingChannel", "status", "changes", "tests", "evidence", "findings", "risks", "blockers", "recommendation"],
      "properties": {
        "taskId": { "type": "string" }, "assignmentId": { "type": "string" }, "agentId": { "type": "string" }, "role": { "type": "string" },
        "stance": { "$ref": "#/$defs/Stance" }, "provider": { "type": "string" }, "harness": { "type": "string" },
        "billingChannel": { "type": "string", "enum": ["subscription", "api", "manual"] },
        "status": { "type": "string", "enum": ["completed", "blocked", "failed", "cancelled"] },
        "changes": { "type": "array", "items": { "type": "string" } },
        "tests": { "type": "array", "items": { "$ref": "#/$defs/GateResult" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/Evidence" } },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
        "risks": { "type": "array", "items": { "type": "string" } },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "recommendation": { "type": "string", "enum": ["continue", "review", "changes_required", "ready", "human_required"] }
      }
    },
    "ReviewResult": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewerAgentId", "verdict", "findingIds", "evidenceIds"],
      "properties": {
        "reviewerAgentId": { "type": "string" }, "verdict": { "type": "string", "enum": ["approve", "changes_requested", "comment"] },
        "findingIds": { "type": "array", "items": { "type": "string" } }, "evidenceIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "MergeDecision": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "rationale", "evidenceIds"],
      "properties": {
        "decision": { "type": "string", "enum": ["ready", "changes_required", "human_required", "blocked"] },
        "rationale": { "type": "string" }, "evidenceIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "RunManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["runId", "task", "assignments", "results", "gates"],
      "properties": {
        "runId": { "type": "string" }, "task": { "$ref": "#/$defs/TaskEnvelope" },
        "assignments": { "type": "array", "items": { "$ref": "#/$defs/AgentAssignment" } },
        "results": { "type": "array", "items": { "$ref": "#/$defs/AgentResult" } },
        "gates": { "type": "array", "items": { "$ref": "#/$defs/GateResult" } },
        "mergeDecision": { "$ref": "#/$defs/MergeDecision" }
      }
    }
  }
}
